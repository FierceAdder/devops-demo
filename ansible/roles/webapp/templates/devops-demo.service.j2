[Unit]
Description=DevOps Demo Spring Boot Application
After=network.target

[Service]
User={{ app_user }}
WorkingDirectory={{ app_dest }}
ExecStart=/usr/bin/java -jar {{ app_dest }}/devops-demo.jar
Environment="SERVER_PORT={{ app_port }}"
Environment="SPRING_PROFILES_ACTIVE={{ app_env }}"
SuccessExitStatus=143
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=devops-demo

[Install]
WantedBy=multi-user.target
